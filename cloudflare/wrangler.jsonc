{
  // Joy To Play na Cloudflare Pages: Cloudflare ho sestaví z GitHubu (větev main, složka cloudflare/) příkazem npm run build.
  // Sestavení zabalí src/worker.js do public/_worker.js. Zkušební Worker na workers.dev má vlastní wrangler.worker.jsonc.
  "name": "joytoplay",
  "pages_build_output_dir": "public",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "joytoplay", "database_id": "d93ce5f6-7fb3-43c9-8f47-170b4962eaf5" }
  ],
  "vars": {
    "SITE_URL": "https://kytara.tomasjindra.cz",
    // Turnstile widget „Joy To Play formulář“. Tajný klíč TURNSTILE_SECRET a heslo ADMIN_PASSWORD jsou secrets v nastavení Pages projektu.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFlB1VM18DZCqfnm"
  }
}
